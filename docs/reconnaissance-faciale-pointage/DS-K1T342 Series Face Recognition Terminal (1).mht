@charset "utf-8";

@media only screen and (max-width: 768px) {
  .wt_custom_mobile_common_model { display: flex; align-items: center; height: 50px; line-height: 24px; color: var(--font-color-custom-mobile-title); font-size: 16px; text-align: center; padding: 13px 0px; border-bottom: var(--border-normal); }
  .wt_custom_type_header { width: 110px; text-align: center; padding: 16px 15px; }
  .wt_custom_type_title { padding: 0px; }
  .wt_custom_type_body.wt_select { width: calc(100% - 118px); padding: 8px 16px; text-align: left; }
}

