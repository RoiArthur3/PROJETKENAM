.caution > .p, .danger > .p, .warning > .p, .note > .p { margin-top: 8px; margin-bottom: 0px; font-size: 13px; line-height: 20px; color: var(--font-color-note-content); font-weight: normal !important; }

.note_noline .p { margin-top: 0px; color: var(--font-color-note-content); }

.caution .li .p, .danger .li .p, .warning .li .p, .note .li .p { padding-left: 0px; font-weight: normal !important; }

td .caution, td .danger, td .warning, td .note { margin-top: 0px; margin-bottom: 14px; }

