.robot-tip { position: absolute; left: -206px; top: 12px; color: rgb(51, 51, 51); font-size: 13px; line-height: 18px; font-weight: 400; padding: 9px 8px; display: none; }

.robot-tip-en { left: -276px; }

.robot-pc:hover .robot-qrcode, .robot-pc:hover .robot-tip { display: inline-block; }

.bubble { background-color: rgb(255, 255, 255); border-radius: 10px; }

.bubble::before { content: ""; position: absolute; width: 0px; height: 0px; border-width: 8px; border-style: solid; border-color: transparent transparent transparent rgb(255, 255, 255); border-image: initial; top: 50%; right: -15px; transform: translateY(-50%); }

.shadow { box-shadow: rgba(0, 0, 0, 0.08) 0px 9px 20px 8px; }

#language { background: transparent; color: rgb(255, 255, 255); padding: 0px 4px; border-color: transparent; outline: none; }

.wt_header_langue.wt_pc_only::after, .wt_header_langue_mobile.wt_mobile_only::after { content: ""; display: none; }

#language option { color: rgb(51, 51, 51); }

.wt_header_langue_mobile.wt_mobile_only #language { background: transparent; color: rgb(51, 51, 51); border-color: transparent; outline: none; }

.wt_topic_wpp_item.like, .wt_topic_wpp_item.view { font-size: 14px; line-height: 22px; }

.body_wpp.mobile_only { display: block; }

@media only screen and (min-width: 768px) {
  .body_wpp.mobile_only { display: none; }
}

.wt_header_QRcode.wt_pc_only { position: relative; }

.wt_header_QRcode.wt_pc_only #qrCodeImg { display: none; width: 148px; height: 148px; position: absolute; top: 57px; }

#dynamic-dialog__wrapper { background: rgba(0, 0, 0, 0.3); width: 100%; height: 100%; overflow: hidden; position: fixed; top: 0px; left: 0px; z-index: 10; display: none; }

.dynamic-dialog { width: 70%; max-width: 800px; position: fixed; top: 12%; left: 50%; transform: translateX(-50%); background: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.2) 0px 4px 12px 0px; z-index: 10 !important; }

.dynamic-dialog__header { color: rgb(0, 0, 0); border-bottom: 1px solid rgb(217, 217, 217); margin: 0px; padding: 12px 16px; box-sizing: border-box; font-size: 14px; }

#dynamic-close__dialog { width: 12px; height: 12px; margin-top: 4px; }

.dynamic-dialog__body { margin: 0px; padding: 20px 16px 0px; color: rgb(0, 0, 0); text-align: left; font-size: 1.5rem; max-height: 72vh; overflow-y: auto; border-bottom: 1px solid rgb(217, 217, 217); }

.dynamic-dialog__footer { padding: 12px 16px; text-align: right; }

.dynamic-dialog__btn { font-size: 0.8rem; line-height: normal; display: inline-block; text-align: center; border-radius: 4px; margin-right: 10px; border: none; outline: none; padding: 6px 28px; cursor: pointer; }

.dynamic-dialog-submit__btn { background: rgb(202, 29, 34); color: rgb(255, 255, 255); }

.dynamic-dialog-cancel__btn { background: rgb(255, 255, 255); color: rgb(102, 102, 102); border: 1.14px solid rgb(217, 217, 217); margin-right: 0px; }

.dynamic-margin-0 { margin: 0px; }

.dynamic-paddingtop-0 { padding-top: 0px !important; }

.dynamic-paddingbot-0 { padding-bottom: 0px !important; }

.dynamic-text-right { text-align: right; }

.dynamic-dialog input[type="radio"], .dynamic-dialog input[type="checkbox"] { display: none; }

.dynamic-dialog input[type="radio"]:checked + label::before, .dynamic-dialog input[type="checkbox"]:checked + label::before { background: -webkit-radial-gradient(center, circle closest-side, rgb(202, 29, 34) 60%, rgb(255, 255, 255) 40%); border: 1px solid rgb(202, 29, 34); }

.dynamic-dialog input[type="checkbox"]:checked ~ div.dynamic-form-item__row__input { display: block; }

.dynamic-dialog input[type="checkbox"]:checked + label::before { background: rgb(202, 29, 34); }

.dynamic-dialog input[type="checkbox"]:checked + label::after { border-width: 0px 2px 2px 0px; border-right-style: solid; border-bottom-style: solid; border-right-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-image: initial; border-left-style: initial; border-left-color: initial; border-top-style: initial; border-top-color: initial; box-sizing: content-box; content: ""; height: 7px; left: 6px; position: absolute; top: 4px; transform: rotate(45deg); transform-origin: center center; transition: transform 0.1s cubic-bezier(0.12, 0.4, 0.29, 1.46) 0.1s; width: 3px; }

.dynamic-dialog input[type="file"] { display: block; }

.dynamic-dialog input, .dynamic-dialog textarea, .dynamic-dialog select { outline: none; }

.dynamic-dialog input[type="radio"] + label::before, .dynamic-dialog input[type="checkbox"] + label::before { content: ""; display: inline-block; width: 16px; height: 16px; border: 1px solid rgb(187, 187, 187); border-radius: 50px; margin-bottom: -3px; margin-right: 4px; cursor: pointer; }

.dynamic-dialog input[type="checkbox"] + label::before { border-radius: 2px; }

.dynamic-radio__label { margin: 0px 20px 0px 0px; font-weight: 400; font-size: 14px; position: relative; white-space: nowrap; border: 0px !important; background: none transparent !important; border-radius: 0px !important; width: auto !important; height: auto !important; }

.dynamic-radio__span { width: 8px; height: 8px; display: none; background: rgb(202, 29, 34); border-radius: 10px; position: absolute; left: 4px; top: 6px; }

.dynamic-form__cls { padding-bottom: 0px; }

.dynamic-form-item { display: flex; padding-bottom: 20px; overflow: hidden; }

.dynamic-form-item__label { display: inline-block; font-size: 14px; width: 55%; letter-spacing: 0px; white-space: nowrap; font-weight: 400; color: rgb(51, 51, 51); line-height: 22px; margin-bottom: 0px; }

.dynamic-form-item__label2 { width: 80px; line-height: 28px; text-align: right; }

.dynamic-form-item__content { flex: 1 1 0%; line-height: 16px; }

.is-usemanual { padding-bottom: 16px; }

.dynamic-textarea__cls { box-sizing: border-box; width: 100%; resize: vertical; padding: 5px 10px; border: 1px solid rgb(187, 187, 187); border-radius: 4px; font-size: 14px; }

.dynamic-input__cls { width: 100%; font-size: 14px; padding: 5px 10px; border: 1px solid rgb(187, 187, 187); border-radius: 4px; white-space: nowrap; text-overflow: ellipsis; box-sizing: border-box; }

.dynamic-dialog input[disabled].dynamic-input__cls { border: 0px; background: transparent; }

#imgCont { display: inline-block; vertical-align: top; }

.imgCont-label__cls { display: inline-block; width: 80px; height: 80px; border: 1px dashed rgb(187, 187, 187); background-color: rgb(250, 250, 250); border-radius: 4px; position: relative; margin: 1px 0px 6px; cursor: pointer; }

.upload-img-view { vertical-align: top; width: 80px; height: 80px; border: 1px solid rgb(187, 187, 187); margin-right: 6px; margin-bottom: 6px; display: inline-block; overflow: hidden; position: relative; }

.dynamic-dialog .upload-img-view img { width: 78px; height: 78px; margin-top: 1px; margin-left: 1px; object-fit: cover; }

.dynamic-remove-img { position: absolute; right: 2px; top: 2px; display: inline-block; font-size: 13px; width: 16px; height: 16px; text-align: center; line-height: 13px; font-style: normal; background: rgba(0, 0, 0, 0.6); border-radius: 50%; color: rgb(255, 255, 255); cursor: pointer; }

.dynamic-is-required .dynamic-form-item__label::before { color: rgb(224, 54, 59); content: "*"; margin-right: 4px; }

.dynamic-is-error input, .dynamic-is-error textarea { border-color: rgb(224, 54, 59); }

.dynamic-is-error .dynamic-form-item__error { display: block; }

.dynamic-form-item__error { display: none; position: absolute; color: rgb(255, 108, 96); font-size: 12px; }

.dynamic-form-item__tip { font-size: 12px; color: rgb(153, 153, 153); line-height: 18px; }

.dynamic-bot-tip { font-size: 12px; color: rgb(102, 102, 102); letter-spacing: 0px; line-height: 16px; font-weight: 400; margin-bottom: 20px; }

.dynamic-flex-column { display: flex; flex-direction: column; padding-bottom: 0px; }

.dynamic-form-item__row { line-height: 19px; margin-bottom: 16px; }

.dynamic-form-item__row__input { position: relative; margin-top: 16px; display: none; }

.dynamic-solved__container, .dynamic-not-solved__container { padding-top: 0px; }

.dynamic-solved__container { display: none; }

.dynamic-not-solved__container { display: block; }

.dynamic-is-hidden { display: none; }

.dynamic-useManual__container { display: none; }

.star-wrapper { display: inline-block; width: 50%; text-align: right; white-space: nowrap; vertical-align: middle; }

.star-wrapper .star-item { display: inline-block; margin: 0px; cursor: pointer; }

.star-item + .star-item { margin-left: 20px; }

.dynamic-is-block { display: block !important; }

.dynamic-margin-bot { margin-bottom: 10px; }

.dynamic-is-relative { position: relative; }

.dynamic-dialog__wrapper__en .dynamic-form-item__label2 { width: 120px; text-align: left; }

.dynamic-dialog__wrapper__en .dynamic-radio__label { white-space: inherit; }

.dynamic-dialog__wrapper__moa .dynamic-dialog { width: 100%; height: calc(100% - 40px); top: 0px; display: flex; flex-direction: column; background: rgb(245, 246, 247); }

.dynamic-dialog__wrapper__moa .dynamic-dialog__header { height: 40px; padding: 10px 16px; color: rgb(255, 255, 255); background-color: rgb(32, 32, 33); }

.dynamic-dialog__wrapper__moa .dynamic-dialog__body { padding: 0px; flex: 1 1 0%; max-height: initial; }

.dynamic-dialog__wrapper__moa .dynamic-form__cls { border-bottom: 0px; }

.dynamic-dialog__wrapper__moa .dynamic-dialog input, .dynamic-dialog__wrapper__moa .dynamic-dialog select { text-align: right; border-width: 0px; }

.dynamic-dialog__wrapper__moa .dynamic-dialog textarea { border-width: 0px; resize: none; }

.dynamic-dialog__wrapper__moa .dynamic-form-item { background: rgb(255, 255, 255); padding: 10px 16px; border-bottom: 1px solid rgb(235, 237, 240); }

.dynamic-dialog__wrapper__moa .dynamic-not-solved__container, .dynamic-dialog__wrapper__moa .dynamic-solved__container { padding-top: 0px; }

.dynamic-dialog__wrapper__moa .dynamic-form-item__label { line-height: 30px; margin-bottom: 0px; }

.dynamic-dialog__wrapper__moa .dynamic-dialog__footer { padding: 6px 16px; }

.dynamic-dialog__wrapper__moa .dynamic-dialog-submit__btn { width: 100%; height: 40px; }

.dynamic-dialog__wrapper__moa .dynamic-bot-tip { display: inline-block; padding: 10px 16px; }

.dynamic-dialog__wrapper__moa .imgCont-label__cls { width: 56px; height: 56px; }

.dynamic-dialog__wrapper__moa .upload-img-view { vertical-align: top; width: 56px; height: 56px; border: 1px solid rgb(187, 187, 187); margin-right: 6px; margin-bottom: 6px; display: inline-block; overflow: hidden; position: relative; }

.dynamic-dialog__wrapper__moa .upload-img-view img { width: 54px; height: 54px; margin-top: 1px; margin-left: 1px; object-fit: cover; }

.dynamic-dialog__wrapper__moa #imgCont { margin-top: 10px; }

.dynamic-dialog__wrapper__moa .dynamic-form-item__row__input { padding-bottom: 12px; }

.dynamic-dialog__wrapper__moa .dynamic-radio__label { white-space: inherit; line-height: 30px; }

.dynamic-dialog__wrapper__moa .dynamic-dialog input[type="checkbox"] + label::before { margin-top: 0px; }

.dynamic-dialog__wrapper__moa .dynamic-form-item__error { bottom: 2px; }

.dynamic-dialog__wrapper__moa .dynamic-form-item__row { line-height: 30px; }

.dynamic-dialog__wrapper__moa .dynamic-input__cls { padding: 0px 10px; height: 32px; }

.dynamic-dialog__wrapper__moa .dynamic-dialog input[type="checkbox"]:checked + label::after { top: 3px; }

.dynamic-dialog__wrapper__moa .star-item + .star-item { margin-left: 10px; }

.dynamic-dialog__wrapper__moa .star-wrapper { width: 100%; margin-top: 5px; }

.dynamic-dialog__wrapper__moa .is-usemanual { border-bottom: 0px; padding: 0px 16px; }

