@push('scripts')
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

<script>
    let availableServices = @json($services ?? []);

    function addValidationService() {
        const serviceId = 'validation_service_' + Date.now();
        const serviceHtml = `
            <div id="${serviceId}" class="d-flex align-items-center mb-2 p-2 bg-white rounded border">
                <select class="form-select form-select-sm me-2" onchange="updateValidationServices()">
                    <option value="">Choisir un service...</option>
                    ${availableServices.map(service =>
                        `<option value="${service.id}">${service.nom}</option>`
                    ).join('')}
                </select>
                <button type="button" class="btn btn-sm btn-danger" onclick="removeValidationService('${serviceId}')">
                    <i class="fas fa-trash"></i>
                </button>
            </div>`;

        document.getElementById('validationServicesList').insertAdjacentHTML('beforeend', serviceHtml);
        updateValidationServices();
    }

    function removeValidationService(serviceId) {
        document.getElementById(serviceId).remove();
        updateValidationServices();
    }

    function updateValidationServices() {
        const selects = document.querySelectorAll('#validationServicesList select');
        const services = Array.from(selects)
            .map(select => select.value)
            .filter(value => value !== '');

        document.getElementById('services_validation').value = services.join(',');
    }

    // Validation automatique du formulaire avant soumission
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.getElementById('operationForm');
        if (form) {
            form.addEventListener('submit', function(e) {
                const servicesValidation = document.getElementById('services_validation').value;

                if (!servicesValidation || servicesValidation.trim() === '') {
                    e.preventDefault();
                    alert('Veuillez sélectionner au moins un service de validation.');
                    return false;
                }

                return true;
            });
        }
    });

    // Initialiser Sortable pour le réordonnancement
    document.addEventListener('DOMContentLoaded', function() {
        const container = document.getElementById('validationServicesList');
        if (container) {
            new Sortable(container, {
                animation: 150,
                ghostClass: 'sortable-ghost'
            });
        }
    });
</script>
@endpush

    }

    function updateValidationServices() {
        const selects = document.querySelectorAll('#validationServicesList select');
        const selectedServices = [];

        selects.forEach(select => {
            if (select.value) {
                selectedServices.push(select.value);
            }
        });

        document.getElementById('services_validation').value = selectedServices.join(',');
    }

    // Ajouter un premier service automatiquement si des services sont disponibles
    document.addEventListener('DOMContentLoaded', function() {
        if (availableServices && availableServices.length > 0) {
            addValidationService();
        }
    });

    // Gestion des aperçus de fichiers
    document.addEventListener('DOMContentLoaded', function() {
        const fileInput = document.getElementById('fichiers');
        if (fileInput) {
            fileInput.addEventListener('change', handleFileSelect);
        }
    });

    function handleFileSelect(event) {
        const files = event.target.files;
        const preview = document.getElementById('filePreview');

        // Vider les aperçus existants
        preview.innerHTML = '';

        if (files.length > 0) {
            Array.from(files).forEach((file, index) => {
                const fileItem = createFileItem(file, index);
                preview.appendChild(fileItem);
            });
        }
    }

    function createFileItem(file, index) {
        const fileItem = document.createElement('div');
        fileItem.className = 'file-item mb-2 p-2 border rounded';

        const fileIcon = getFileIcon(file.name);
        const fileSize = formatFileSize(file.size);

        fileItem.innerHTML = `
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <i class="${fileIcon} fa-2x text-primary"></i>
                </div>
                <div class="flex-grow-1">
                    <div class="fw-semibold">${file.name}</div>
                    <small class="text-muted">${fileSize}</small>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.parentElement.remove()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        `;

        return fileItem;
    }

    function getFileIcon(filename) {
        const extension = filename.split('.').pop().toLowerCase();
        const iconMap = {
            'pdf': 'fas fa-file-pdf',
            'doc': 'fas fa-file-word',
            'docx': 'fas fa-file-word',
            'xls': 'fas fa-file-excel',
            'xlsx': 'fas fa-file-excel',
            'jpg': 'fas fa-file-image',
            'jpeg': 'fas fa-file-image',
            'png': 'fas fa-file-image'
        };

        return iconMap[extension] || 'fas fa-file';
    }
</script>

