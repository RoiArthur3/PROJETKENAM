<script>
document.addEventListener('DOMContentLoaded', function() {
    // Gestion des toggles de modules
    document.querySelectorAll('.module-toggle').forEach(toggle => {
        toggle.addEventListener('change', function() {
            const module = this.dataset.module;
            const submodulesContainer = document.getElementById('submodules_' + module);
            
            if (this.checked) {
                submodulesContainer.style.display = 'block';
                // Cocher tous les sous-modules par défaut
                submodulesContainer.querySelectorAll('.submodule-checkbox').forEach(cb => {
                    cb.checked = true;
                });
            } else {
                submodulesContainer.style.display = 'none';
                // Décocher tous les sous-modules
                submodulesContainer.querySelectorAll('.submodule-checkbox').forEach(cb => {
                    cb.checked = false;
                });
            }
            
            updatePreview();
            updateCounts();
        });
    });

    // Gestion des sous-modules
    document.querySelectorAll('.submodule-checkbox').forEach(checkbox => {
        checkbox.addEventListener('change', function() {
            updatePreview();
            updateCounts();
        });
    });

    // Actions rapides
    document.querySelectorAll('.select-all-submodules').forEach(btn => {
        btn.addEventListener('click', function() {
            const module = this.dataset.module;
            document.querySelectorAll(`#submodules_${module} .submodule-checkbox`).forEach(cb => {
                cb.checked = true;
            });
            updatePreview();
            updateCounts();
        });
    });

    document.querySelectorAll('.deselect-all-submodules').forEach(btn => {
        btn.addEventListener('click', function() {
            const module = this.dataset.module;
            document.querySelectorAll(`#submodules_${module} .submodule-checkbox`).forEach(cb => {
                cb.checked = false;
            });
            updatePreview();
            updateCounts();
        });
    });

    // Fonctions de mise à jour
    function updatePreview() {
        document.querySelectorAll('.preview-module').forEach(module => {
            const moduleKey = module.dataset.module;
            const isModuleChecked = document.getElementById('module_' + moduleKey).checked;
            const hasCheckedSubmodules = module.querySelectorAll('.submodule-checkbox:checked').length > 0;
            
            const card = module.querySelector('.card');
            const header = module.querySelector('.card-header');
            
            if (isModuleChecked && hasCheckedSubmodules) {
                card.className = 'card h-100 border-success';
                header.className = 'card-header py-2 bg-success text-white';
            } else {
                card.className = 'card h-100 border-secondary opacity-50';
                header.className = 'card-header py-2 bg-light';
            }
            
            // Mettre à jour les sous-modules dans l'aperçu
            module.querySelectorAll('li').forEach((li, index) => {
                const subKey = li.querySelector('i').parentElement.textContent.trim();
                const submoduleCheckbox = document.querySelector(`#submodules_${moduleKey} .submodule-checkbox:nth-child(${index + 1})`);
                if (submoduleCheckbox && submoduleCheckbox.checked) {
                    li.className = 'text-success';
                } else {
                    li.className = 'text-muted text-decoration-line-through';
                }
            });
        });
    }

    function updateCounts() {
        document.querySelectorAll('.module-section').forEach(section => {
            const module = section.querySelector('.module-toggle').dataset.module;
            const totalSubmodules = section.querySelectorAll('.submodule-checkbox').length;
            const checkedSubmodules = section.querySelectorAll(`#submodules_${module} .submodule-checkbox:checked`).length;
            
            section.querySelector('.selected-count').textContent = `${checkedSubmodules}/${totalSubmodules}`;
        });
    }

    // Initialisation
    updatePreview();
    updateCounts();
});

// Actions globales
function selectAllModules() {
    document.querySelectorAll('.module-toggle').forEach(toggle => {
        toggle.checked = true;
        toggle.dispatchEvent(new Event('change'));
    });
}

function resetAll() {
    document.querySelectorAll('.module-toggle').forEach(toggle => {
        toggle.checked = false;
        toggle.dispatchEvent(new Event('change'));
    });
}
</script>

<style>
.module-section {
    border-left: 4px solid #007bff;
    padding-left: 1rem;
    margin-left: 0.5rem;
}

.submodules-container {
    background: #f8f9fa;
    border-radius: 0.5rem;
    padding: 1rem;
    border: 1px dashed #dee2e6;
}

.preview-module .card {
    transition: all 0.3s ease;
}

.preview-module .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.form-check-input:checked {
    background-color: #007bff;
    border-color: #007bff;
}
</style>
