        return view('parametrage.entreprise', compact('entreprise', 'emailConfig', 'systemConfig'));
    }

    /**
     * Sauvegarder les paramètres de l'entreprise
     */
    public function saveEntreprise(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'nom_entreprise' => 'required|string|max:255',
            'sigle' => 'required|string|max:50',
            'adresse' => 'required|string',
            'telephone' => 'required|string|max:20',
            'email_contact' => 'required|email|max:255',
            'site_web' => 'required|string|max:255',
            'rccm' => 'required|string|max:50',
            'ifu' => 'nullable|string|max:50',
            'cnss' => 'nullable|string|max:50',
            'compte_bancaire' => 'required|string|max:100',
            'tva_rate' => 'required|numeric|min:0|max:100',
            'email_tresorerie' => 'nullable|email|max:255',
            'email_caisse_1' => 'nullable|email|max:255',
            'email_caisse_2' => 'nullable|email|max:255',
            'email_destinataire_principal' => 'nullable|email|max:255',
            'seuil_validation_dg' => 'nullable|numeric|min:0',
            'seuil_validation_principal' => 'nullable|numeric|min:0',
            'logo_entreprise' => 'nullable|image|mimes:jpeg,png,jpg,gif|max:2048'
        ]);

        if ($validator->fails()) {
            return response()->json(['success' => false, 'errors' => $validator->errors()], 422);
        }

        try {
            $entreprise = EntrepriseSettings::getActive();
            if (!$entreprise) {
                $entreprise = new EntrepriseSettings();
                $entreprise->actif = true;
            }

            $data = $request->except(['logo_entreprise', '_token']);

            // Gestion de l'upload du logo
            if ($request->hasFile('logo_entreprise')) {
                // Supprimer l'ancien logo si nécessaire
                if ($entreprise->logo_path && File::exists(public_path('storage/' . $entreprise->logo_path))) {
                    try {
                        File::delete(public_path('storage/' . $entreprise->logo_path));
                    } catch (\Exception $e) {
                        // Ignorer si échec de suppression
                    }
                }

                $file = $request->file('logo_entreprise');
                $filename = 'logo_' . time() . '.' . $file->getClientOriginalExtension();
                $file->storeAs('logos', $filename, 'public');
                $data['logo_path'] = 'logos/' . $filename;
            }

            $entreprise->fill($data);
            $entreprise->save();

            // Effacer le cache pour que les changements soient visibles immédiatement
            \Illuminate\Support\Facades\Cache::forget('entreprise_settings.active');

            return response()->json([
                'success' => true,
                'message' => 'Informations de l\'entreprise mises à jour avec succès.',
                'logo_url' => $entreprise->logo_path ? asset('storage/' . $entreprise->logo_path) : null
            ]);
        } catch (\Exception $e) {
            return response()->json(['success' => false, 'message' => 'Erreur: ' . $e->getMessage()], 500);
        }
    }

    /**
     * Sauvegarder la configuration SMS
     */
    public function saveSms(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'sms_provider' => 'nullable|string|max:50',
            'sms_api_key' => 'nullable|string|max:255',
            'sms_api_secret' => 'nullable|string|max:500',
            'sms_username' => 'nullable|string|max:255',
            'sms_password' => 'nullable|string|max:500',
            'sms_sender_id' => 'nullable|string|max:20',
            'sms_api_url' => 'nullable|string|max:255',
            'sms_is_active' => 'nullable'
        ]);

        if ($validator->fails()) {
            return response()->json(['success' => false, 'errors' => $validator->errors()], 422);
        }

        try {
            $entreprise = EntrepriseSettings::getActive();
            if (!$entreprise) {
                $entreprise = new EntrepriseSettings();
                $entreprise->actif = true;
            }

            $smsUsername = $request->input('sms_username', $request->input('sms_api_key'));
            $smsPassword = $request->input('sms_password', $request->input('sms_api_secret'));

            $data = [
                'sms_provider' => $request->input('sms_provider'),
                'sms_api_key' => $request->input('sms_api_key', $smsUsername),
                'sms_api_secret' => $request->input('sms_api_secret', $smsPassword),
                'sms_username' => $smsUsername,
                'sms_password' => $smsPassword,
                'sms_sender_id' => $request->input('sms_sender_id'),
                'sms_api_url' => $request->input('sms_api_url'),
            ];

            $data['sms_is_active'] = $request->has('sms_is_active');

            $entreprise->update($data);

            \Illuminate\Support\Facades\Cache::forget('entreprise_settings.active');

            return response()->json([
                'success' => true,
                'message' => 'Configuration SMS enregistrée avec succès.'
            ]);
        } catch (\Exception $e) {
            return response()->json(['success' => false, 'message' => 'Erreur: ' . $e->getMessage()], 500);
        }
    }

