    /**
     * Afficher la page de configuration des services
     */
    public function services()
    {
        try {
            // Récupérer tous les services opérationnels
            $services = \App\Models\ServiceOperationnel::withCount('operations')
                ->orderBy('nom')
                ->get();

            // Récupérer les types d'opérations
            $typesOperations = \App\Models\TypeOperation::orderBy('libelle')
                ->where('actif', true)
                ->get();

            // Récupérer les utilisateurs par rôle
            $usersByRole = \App\Models\User::select('role', \DB::raw('count(*) as count'))
                ->groupBy('role')
                ->orderBy('count', 'desc')
                ->get();

            return view('parametrage.services', compact('services', 'typesOperations', 'usersByRole'));

        } catch (\Exception $e) {
            // En cas d'erreur, retourner une vue avec des données vides
            return view('parametrage.services', [
                'services' => collect([]),
                'typesOperations' => collect([]),
                'usersByRole' => collect([])
            ]);
        }
    }

