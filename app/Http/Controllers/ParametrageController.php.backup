            // Si le modèle n'existe pas, créer un objet stdClass avec des propriétés par défaut
            $entreprise = (object) [
                'nom_entreprise' => 'KENAM Services',
                'sigle' => 'KENAM',
                'adresse' => '',
                'telephone' => '',
                'email_contact' => '',
                'site_web' => '',
                'rccm' => '',
                'ifu' => '',
                'cnss' => '',
                'compte_bancaire' => '',
                'tva_rate' => 18.00,
                'email_tresorerie' => '',
                'email_caisse_1' => '',
                'email_caisse_2' => '',
                'email_destinataire_principal' => '',
                'email_dg' => '',
                'seuil_validation_dg' => 1000000,
                'seuil_validation_principal' => 500000,
                'sms_provider' => '',
                'sms_api_key' => '',
                'sms_api_secret' => '',
                'sms_sender_id' => '',
                'sms_api_url' => '',
                'sms_is_active' => false,
                'logo_path' => null,
                'id' => null
            ];
        }

        $emailConfig = \App\Models\Setting::get('email_config', []);
