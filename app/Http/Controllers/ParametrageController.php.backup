    /**
     * Sauvegarder la configuration Hikvision
     */
    public function saveHikvision(Request $request)
    {
        $validator = Validator::make($request->all(), [
            'ip' => 'required|ip',
            'port' => 'required|integer|min:1|max:65535',
            'username' => 'required|string|max:100',
            'password' => 'required|string|max:255',
            'timeout' => 'nullable|integer|min:1|max:300',
            'endpoint' => 'nullable|string|max:255',
        ]);

        if ($validator->fails()) {
            return back()->withErrors($validator)->withInput();
        }

        try {
            // Mettre à jour le fichier .env
            $envPath = base_path('.env');
            $envContent = file_get_contents($envPath);

            $configs = [
                'HIKVISION_IP' => $request->ip,
                'HIKVISION_PORT' => $request->port,
                'HIKVISION_USER' => $request->username,
                'HIKVISION_PASS' => $request->password,
                'HIKVISION_TIMEOUT' => $request->timeout ?? '30',
                'HIKVISION_ENDPOINT' => $request->endpoint ?? '/ISAPI/AccessControl/AcsEvent',
            ];

            foreach ($configs as $key => $value) {
                $pattern = "/^{$key}=.*/m";
                $replacement = "{$key}={$value}";

                if (preg_match($pattern, $envContent)) {
                    $envContent = preg_replace($pattern, $replacement, $envContent);
                } else {
                    $envContent .= "\n{$key}={$value}";
                }
            }

            file_put_contents($envPath, $envContent);

            return back()->with('success', 'Configuration Hikvision sauvegardée avec succès');
        } catch (\Exception $e) {
            return back()->with('error', 'Erreur lors de la sauvegarde de la configuration: ' . $e->getMessage());
        }
    }

    /**
     * Tester la connexion Hikvision
     */
    public function testHikvision(Request $request)
    {
        try {
            $ip = $request->input('ip', env('HIKVISION_IP', '192.168.1.70'));
            $port = $request->input('port', env('HIKVISION_PORT', '80'));
            $username = $request->input('username', env('HIKVISION_USER', 'admin'));
            $password = $request->input('password', env('HIKVISION_PASS', ''));
            $timeout = $request->input('timeout', env('HIKVISION_TIMEOUT', '30'));

            $url = "http://{$ip}:{$port}/ISAPI/System/status";

            $ch = curl_init();
            curl_setopt($ch, CURLOPT_URL, $url);
            curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
            curl_setopt($ch, CURLOPT_TIMEOUT, $timeout);
            curl_setopt($ch, CURLOPT_USERPWD, $username . ':' . $password);
            curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, false);
            curl_setopt($ch, CURLOPT_SSL_VERIFYHOST, false);

            $response = curl_exec($ch);
            $httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);
            $error = curl_error($ch);
            curl_close($ch);

            $success = ($httpCode === 200 && !$error);

            return response()->json([
                'success' => $success,
                'message' => $success ? 'Connexion Hikvision réussie' : 'Échec de connexion: ' . ($error ?: "HTTP {$httpCode}"),
                'http_code' => $httpCode,
                'response' => $success ? substr($response, 0, 500) : null
            ]);

        } catch (\Exception $e) {
            return response()->json([
                'success' => false,
                'message' => 'Erreur de test: ' . $e->getMessage()
            ]);
        }
    }

    /**
     * Diagnostic Hikvision
     */
    public function hikvisionDiagnostic(Request $request)
    {
        try {
            $diagnostic = [
                'config' => [
                    'ip' => env('HIKVISION_IP', 'Non configuré'),
                    'port' => env('HIKVISION_PORT', 'Non configuré'),
                    'username' => env('HIKVISION_USER', 'Non configuré'),
                    'password' => env('HIKVISION_PASS') ? '***' : 'Non configuré',
                    'timeout' => env('HIKVISION_TIMEOUT', 'Non configuré'),
                ],
                'connectivity' => $this->testHikvision($request)->getData(true),
                'environment' => [
                    'php_version' => PHP_VERSION,
                    'curl_enabled' => function_exists('curl_version'),
                    'allow_url_fopen' => ini_get('allow_url_fopen'),
                ]
            ];

            return response()->json($diagnostic);
        } catch (\Exception $e) {
            return response()->json([
                'error' => 'Erreur lors du diagnostic: ' . $e->getMessage()
            ]);
        }
    }

    /**
     * Synchronisation Hikvision
     */
    public function hikvisionSync(Request $request)
    {
        try {
            // Appeler le service de synchronisation
            $syncService = app(\App\Services\HikvisionFaceSyncService::class);
            $results = $syncService->syncAllPendingEmployees();

            return response()->json([
                'success' => true,
                'message' => 'Synchronisation lancée',
                'results' => $results
            ]);
        } catch (\Exception $e) {
            return response()->json([
                'success' => false,
                'message' => 'Erreur lors de la synchronisation: ' . $e->getMessage()
            ]);
        }
    }
